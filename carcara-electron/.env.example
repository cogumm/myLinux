# Carcará 2.0 (Electron) — copy to `.env` and adjust.
# Loaded by `src/env.ts` (Zod). Do not commit real `.env`.

# --- Connectivity (testConnection.sh / action `ping`) ---
# Google Public DNS IP (ICMP probe)
CARCARA_TEST_HOST=8.8.8.8
CARCARA_TEST_COUNT=3

# --- App policy ---
# UI language for 1.x + 2.0 menus (pt | en). Also honored as CARCARA_LANG for Bash.
CARCARA_LANG=pt
# 0 = UI as desktop user (default; privilege via helper/pkexec). 1 = legacy require root.
CARCARA_REQUIRE_ROOT=0

# --- Window ---
CARCARA_WINDOW_WIDTH=1080
CARCARA_WINDOW_HEIGHT=760
CARCARA_WINDOW_MIN_WIDTH=780
CARCARA_WINDOW_MIN_HEIGHT=560

# --- WSL / GPU (also set by start.sh when Microsoft WSL is detected) ---
# 1 = software GL (reduces DRI3/MESA noise under WSLg)
LIBGL_ALWAYS_SOFTWARE=1

# --- Helper / 1.x bridge (normally set by carcara-helper.sh; listed for docs) ---
# CARCARA_NONINTERACTIVE=1
# DEBIAN_FRONTEND=noninteractive

# --- Repo bootstrap (used by root start.sh curl|bash; optional here) ---
# MYLINUX_DIR=
# MYLINUX_REPO_URL=https://github.com/cogumm/myLinux.git
# MYLINUX_REPO_BRANCH=main
